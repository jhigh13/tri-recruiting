    "    \"\"\"\n",
    "    matches = df[\n",
    "        (df['first_name'] == first_name) &\n",
    "        (df['last_name'] == last_name) &\n",
    "        ((df.get('college', df.get('college_team', '')) == college))\n",
    "    ]\n",
    "    if not matches.empty:\n",
    "        return matches.iloc[0].get('swimmer', None)\n",
    "    return None\n",
