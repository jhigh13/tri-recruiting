    "            if len(name_parts) > 3:\n",
    "                last += \" \" + \" \".join(name_parts[3:])\n",
    "\n",
    "        runner = session.query(Runner).filter_by(first_name=first, last_name=last).first()\n",
    "        if not runner:\n",
    "            print(\"Runner not found in database for majority decision\")\n",
    "            return\n",
    "        \n",
    "        if runner.majority_score > 0:\n",
    "            runner.swimmer = 1\n",
    "        elif runner.majority_score < 0:\n",
    "            runner.swimmer = 0\n",
    "        else:\n",
    "            runner.swimmer = None  # Tie or no votes\n",
    "\n",
    "        session.commit()\n",
    "        print(\"Updated swimmer status based on majority score.\")\n",
    "    except SQLAlchemyError as e:\n",
    "        print(f\"Database error during majority decision: {e}\")\n",
    "        session.rollback()\n",
    "    finally:\n",
    "        session.close()"
