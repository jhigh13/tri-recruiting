    "\n",
    "def save_runner_profile(result: dict) -> int:\n",
    "    \"\"\"\n",
    "    Save runner profile information to the database.\n",
    "    Uses SQLAlchemy session and upsert logic.\n",
    "    Returns 1 for swimmer, -1 for non-swimmer, -1 for None/unknown (so majority math is stable).\n",
    "    \"\"\"\n",
    "    session = get_db_session()\n",
    "    try:\n",
    "        runner_name = (result.get(\"runner_name\") or \"\").strip().lower()\n",
    "        if not runner_name:\n",
    "            print(\"Missing runner_name in result; skipping save.\")\n",
    "            return 0\n",
    "        name_parts = runner_name.split()\n",
    "        if len(name_parts) < 2:\n",
    "            print(f\"Invalid runner_name format: '{runner_name}'\")\n",
    "            return 0\n",
    "        first = name_parts[0]\n",
    "        # Support multi-part last names; handle o'neill-like cases safely\n",
    "        last = \" \".join(name_parts[1:])\n",
    "        if len(name_parts) > 2 and name_parts[1].lower() == \"o\" and name_parts[2].startswith(\"'\"):\n",
    "            last = f\"{name_parts[1]}{name_parts[2]}\" + (\" \" + \" \".join(name_parts[3:]) if len(name_parts) > 3 else \"\")\n",
    "\n",
    "        runner = session.query(Runner).filter_by(first_name=first, last_name=last).first()\n",
    "        if not runner:\n",
    "            print(\"Runner not found in database\")\n",
    "            return 0\n",
    "\n",
    "        runner.hometown = result.get(\"hometown\")\n",
    "        runner.high_school = result.get(\"high_school\")\n",
    "        runner.swim_background = result.get(\"swim_background\")\n",
    "        runner.runner_url = result.get(\"selected_profile_url\")\n",
    "        runner.runner_text = result.get(\"full_profile_text\", \"\")\n",
    "        runner.swimmer = result.get(\"has_swim_background\", None)\n",
    "        runner.swim_url = result.get(\"swim_profile_url\") or (result.get(\"swim_profile_urls\", []) or [None])[0]\n",
    "        runner.swim_text = result.get(\"swim_profile_text\", \"\")\n",
    "        runner.rationale = result.get(\"rationale\", \"\")\n",
    "        runner.match_confidence = result.get(\"match_confidence\", \"Need Human Review\")\n",
    "\n",
    "        # Initialize majority_score if None\n",
    "        if runner.majority_score is None:\n",
    "            runner.majority_score = 0\n",
    "        if runner.swimmer == 1:\n",
    "            runner.majority_score += 1\n",
    "        elif runner.swimmer == 0:\n",
    "            runner.majority_score -= 1\n",
    "\n",
    "        session.commit()\n",
    "    except SQLAlchemyError as e:\n",
    "        print(f\"Database error: {e}\")\n",
    "        session.rollback()\n",
